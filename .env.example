# ═══════════════════════════════════════════════
# EcoMart — Environment Configuration
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# ═══════════════════════════════════════════════

# ── Application ──────────────────────────────
CLIENT_URL=http://localhost:3000

# ── PostgreSQL ───────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecomart
DB_USER=ecomart
DB_PASSWORD=ecomart-secret

# ── JWT ──────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRATION=86400000

# ── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=

# ── Gemini AI (optional) ─────────────────────
GEMINI_API_KEY=

# ── PayOS (optional) ─────────────────────────
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/orders
PAYOS_CANCEL_URL=http://localhost:3000/cart
