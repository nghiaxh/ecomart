{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts"]
}
